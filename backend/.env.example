# Configuration for Nyaya Saarathi Backend

# Database connection URL.
# Local Development (SQLite):
DATABASE_URL=sqlite:///./nyaya_saarathi.db

# Intended Shared Postgres DB:
# DATABASE_URL=postgresql://user:password@localhost:5432/nyaya_saarathi

# App environment (dev, test, prod)
ENV=dev
GEMINI_API_KEY=your_api_key_here
